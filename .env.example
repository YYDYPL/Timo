# OpenAI-compatible LLM configuration. Leave these empty to run without AI.
# OpenAI:  https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
# Ollama:   http://localhost:11434/v1 (API key may be left empty)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional request timeout in seconds.
LLM_TIMEOUT=60

# Optional custom SQLite file path. The default is backend/data.db.
# INTERVIEW_DB_PATH=backend/data.db
